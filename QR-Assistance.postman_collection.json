        {
          "name": "POST /api/justifications — Enviar justificante",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "attendanceId", "value": "{{attendanceId}}", "type": "text" },
                { "key": "description", "value": "Estuve enfermo con constancia médica.", "type": "text" },
                { "key": "file", "type": "file", "src": [], "disabled": true, "description": "Opcional: archivo de justificante (PDF, imagen)" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/justifications", "host": ["{{baseUrl}}"], "path": ["api", "justifications"] },
            "description": "Rol: student. attendanceId debe corresponder a una falta (status=absent) del alumno."
          }
        },
        {
          "name": "GET /api/justifications/:id",
